{
	# Admin API on a socket only the caddy user can reach (not TCP 2019). Not "admin off": that breaks
	# systemctl reload caddy.
	admin unix//var/lib/caddy/admin.sock
	# No HTTP/3: ufw drops UDP 443
	servers {
		protocols h1 h2
	}
}

aoe2lobby.online {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Report-only until the browser console shows no violations; then rename to Content-Security-Policy
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}
	# Access log with IPs masked to /24 (IPv4) and /48 (IPv6), kept at most 30 days
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
			}
		}
	}
	# Retry while the app restarts during a deploy instead of returning 502
	reverse_proxy 127.0.0.1:3002 {
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}

# One canonical site for search engines: www permanently redirects to the bare domain
www.aoe2lobby.online {
	redir https://aoe2lobby.online{uri} permanent
}
